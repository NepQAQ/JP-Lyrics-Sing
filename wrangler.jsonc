{
  // Cloudflare Workers 静态资产模式（CF 新版 Git 集成默认走 npx wrangler deploy）
  // 静态站点文件在 public/，/api/* 由 entry.js 里的歌词代理逻辑处理
  "name": "jp-lyrics-sing-dev",
  "main": "entry.js",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    // /api/* 必须先进 Worker，其余直接走静态资产
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://nepqaq.github.io,http://localhost:8765,http://127.0.0.1:8765",
    // 云同步 Dataverse 连接（非机密，可提交；机密用 `wrangler secret put` 设置，不要写进本文件）：
    // DATAVERSE_CLIENT_SECRET 与 JWT_SECRET 由用户在 Cloudflare 面板 / wrangler secret 手动添加
    "DATAVERSE_TENANT_ID": "87508ff1-2b8b-4b0e-96cd-f9277fe47cac",
    "DATAVERSE_ENV_URL": "https://org12aa2f34.api.crm5.dynamics.com",
    "DATAVERSE_CLIENT_ID": "7b6dfd26-3ce6-48b1-8ba5-6ed8f2faa974",
    // 免费版 Workers 每请求约 10ms CPU，默认 100000 迭代可能触发 1102；
    // 行内 jls_iterations 列保证存量账号按注册时的迭代数验证
    "PBKDF2_ITERATIONS": "10000"
    // 音频云端存储（可选，未配置时音频仅本地同步，歌词/配置仍同步）：
    // "SHAREPOINT_SITE_ID": "site-guid",
    // "SHAREPOINT_DRIVE_ID": "drive-guid",
    // "DATAVERSE_PREFIX": "jls"
  },
  // 生产环境：CF 上新建的「生产」Git 项目部署命令需用 npx wrangler deploy -e production，
  // 未指定环境（dev 项目）仍走顶层配置，两者互不影响
  "env": {
    "production": {
      "name": "jp-lyrics-sing"
    }
  }
}
